# Copie este archivo a .env.local y complete los valores. NO suba .env.local al repositorio.
# Inventario completo y clasificación de cada variable: docs/despliegue.md

# --- Modo de desarrollo local (no requiere nada más) ---
# Sin estas variables la aplicación usa memoria, autenticación de desarrollo,
# datos sintéticos y modelo simulado.

# --- Producción (Vercel + Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://[PROYECTO].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[CLAVE-ANONIMA-O-PUBLICABLE]
DATABASE_URL=postgresql://[USUARIO]:[CONTRASENA]@[HOST]:6543/postgres
PERSISTENCIA=drizzle
AUTENTICACION=supabase
MFA_OBLIGATORIA=true
AUDIT_HMAC_KEY=[CADENA-ALEATORIA-LARGA-Y-ESTABLE]
CORREOS_PERMITIDOS=usuario@ejemplo.ec
MODO_DATOS=sintetico

# --- Modelo de lenguaje (elija uno; ambos reciben solo datos sintéticos) ---
# MODELO=gateway:google/gemini-2.5-flash-lite
# AI_GATEWAY_API_KEY=[OPCIONAL-EN-VERCEL]
# MODELO=google:gemini-2.5-flash-lite
# GOOGLE_GENERATIVE_AI_API_KEY=[CLAVE-DE-GOOGLE-AI-STUDIO]
# MODELO_RESPALDO=simulado

# --- Modelo local con Ollama (solo en su equipo; ver docs/modelo-local.md) ---
# MODELO_LOCAL=ollama:qwen2.5:7b
# OLLAMA_URL=http://127.0.0.1:11434

# --- Solo tareas administrativas desde una terminal local; NUNCA en Vercel ---
# SUPABASE_URL=https://[PROYECTO].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=[SECRET-O-SERVICE-ROLE]
# DATABASE_URL_DIRECT=postgresql://[USUARIO]:[CONTRASENA]@[HOST]:5432/postgres
# DATABASE_URL_MIGRACIONES=[SESSION-POOLER-SI-SU-RED-ES-IPV4]
